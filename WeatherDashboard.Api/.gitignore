# Visual Studio / .NET / VS Code gitignore

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.
.vs/
_ReSharper*/
*.DotSettings.user
*.ncrunch*
*.userprefs

# Build results
[Bb]in/
[Oo]bj/
build/
[Bb]uild/

# Visual Studio Code
.vscode/
*.code-workspace

# Rider
.idea/
*.sln.iml

# NuGet
*.nupkg
packages/
project.lock.json
project.assets.json
.nuget/
# NuGet v3
*.lastbuildstate

# Dotnet core
publish/
publish_output/
*.dbmdl

# MSBuild binary and logs
*.log
*.vsix
*.cache
*.resources
*.pdb
*.dll
*.exe

# Test results
TestResults/
*.trx
*.coverage
*.coveragexml

# SQLite / Local DB
*.mdf
*.ldf
*.sqlite
*.db

# Local settings / secrets
appsettings.Development.json
appsettings.*.Local.json
secrets.json
local.settings.json

# Temporary files
*.tmp
*.temp
~$*
*.swp
*.swo

# JetBrains Rider / ReSharper caches and backups
_ReSharper*/
*.resharper
*.DotSettings
*.dotCover

# Coverage and profiling
coverage/
*.coverage
*.lcov
*.prof

# Node / frontend (optional)
node_modules/
bower_components/
dist/
wwwroot/lib/

# Packaging
*.vsix
*.nupkg

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
*.DS_Store
*.AppleDouble
._*